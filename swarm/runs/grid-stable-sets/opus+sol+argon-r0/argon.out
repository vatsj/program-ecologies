{"type":"tool_use","timestamp":"2026-10-23T04:00:46.820Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_595241","parameters":{"command":"python3 -c '\ndef dominates(x, y):\n    return (x[0] > y[0] and x[1] > y[1]) or (x[0] > y[0] and x[2] > y[2]) or (x[1] > y[1] and x[2] > y[2])\n\ndef solve(K):\n    pts = [(a, b, K - a - b) for a in range(K + 1) for b in range(K + 1 - a)]\n    n = len(pts)\n    dom_by = [0] * n\n    doms = [0] * n\n    for i in range(n):\n        for j in range(n):\n            if dominates(pts[i], pts[j]):\n                doms[i] |= (1 << j)\n                dom_by[j] |= (1 << i)\n    all_mask = (1 << n) - 1\n    sols = []\n    def bt(v_mask, cand, need):\n        if need == 0:\n            sols.append(v_mask)\n            return\n        best_u = -1\n        best_opts = 1000000\n        temp = need\n        while temp:\n            lsb = temp & -temp\n            u = lsb.bit_length() - 1\n            opts = (dom_by[u] & cand) | (lsb & cand)\n            if opts == 0:\n                return\n            cnt = opts.bit_count()\n            if cnt < best_opts:\n                best_opts = cnt\n                best_u = u\n                if cnt == 1:\n                    break\n            temp ^= lsb\n        u = best_u\n        opts = (dom_by[u] & cand) | ((1 << u) & cand)\n        while opts:\n            lsb = opts & -opts\n            w = lsb.bit_length() - 1\n            opts ^= lsb\n            new_v = v_mask | lsb\n            conflict = doms[w] | dom_by[w] | lsb\n            new_cand = cand & ~conflict\n            new_need = need & ~(doms[w] | lsb)\n            bt(new_v, new_cand, new_need)\n            cand &= ~lsb\n    bt(0, all_mask, all_mask)\n    print(f\"K={K}: {len(sols)} stable sets\")\n    for s in sols:\n        v = [pts[i] for i in range(n) if (s >> i) & 1]\n        print(\"  \", len(v), v)\n\nfor K in range(11, 19):\n    solve(K)\n'","description":"Run exact solver for K=11..18"}}
