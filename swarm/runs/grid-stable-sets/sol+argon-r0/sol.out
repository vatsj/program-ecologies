)} maximal internally stable sets, {len(survivors)} stable; matches theorem',flush=True)\nif __name__=='__main__': main()\nPY\npython3 /work/sol_verify.py\"","aggregated_output":"Traceback (most recent call last):\n  File \"/work/sol_verify.py\", line 53, in <module>\n    if __name__=='__main__': main()\n                             ^^^^^^\n  File \"/work/sol_verify.py\", line 42, in main\n    cliques=list(maximal_cliques(adj))\n            ^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/work/sol_verify.py\", line 23, in maximal_cliques\n    yield from visit([], (1<<len(adj))-1, 0)\n  File \"/work/sol_verify.py\", line 14, in visit\n    pivot=max(candidates,key=lambda v:(P & adj[v]).bit_count())\n          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nTypeError: 'int' object is not iterable\n","exit_code":1,"status":"failed"}}
