{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nrng=np.random.default_rng(7)\nfor k in range(5):\n v=rng.uniform(.2,5,3); r=rng.uniform(.05,v.sum()-.05); d=v.sum()-r\n u=np.minimum(v,d); s=u.sum()-d\n lo=0.; hi=max(u)\n for _ in range(80):\n  t=(lo+hi)/2\n  if np.minimum(u,t).sum()<s:lo=t\n  else:hi=t\n nearest=np.maximum(v-d,0)+np.minimum(u,(lo+hi)/2)\n print('v=',np.round(v,3),'r=',round(r,3),'nearest=',np.round(nearest,4),'condition=',r<=min(v) or d<=min(v) or np.ptp(v)<1e-10)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
