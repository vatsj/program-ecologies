{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat /work/opus/chk.py'","aggregated_output":"import numpy as np, itertools, random\nfrom scipy.optimize import linprog, minimize\ndef analyze(vP,v):\n    v=np.array(v,float); s=v.sum(); e=s-vP\n    vcg=np.maximum(0,vP-(s-v))\n    # core min revenue\n    A=[];b=[]\n    for T in itertools.chain.from_iterable(itertools.combinations(range(3),k) for k in (1,2,3)):\n        row=np.zeros(3); row[list(T)]=1\n        rhs=max(0,vP-sum(v[j] for j in range(3) if j not in T))\n        A.append(-row); b.append(-rhs)\n    res=linprog(np.ones(3),A_ub=A,b_ub=b,bounds=[(0,x) for x in v]); R=res.fun\n    # polygon vertices: enumerate intersections of 2 constraints with sum=R\n    cons=[(a,bb) for a,bb in zip(A,b)]+[(np.eye(3)[i],v[i]) for i in range(3)]+[(-np.eye(3)[i],0) for i in range(3)]\n    pts=[]\n    for (a1,b1),(a2,b2) in itertools.combinations(cons,2):\n        M=np.array([a1,a2,np.ones(3)])\n        if abs(np.linalg.det(M))<1e-12: continue\n        x=np.linalg.solve(M,[b1,b2,R])\n        if all(np.dot(a,x)<=bb+1e-9 for a,bb in cons): pts.append(x)\n    pts=np.unique(np.round(pts,9),axis=0)\n    # centroid via 2D projection\n    if len(pts)<3: G=pts.mean(0)\n    else:\n        c0=pts.mean(0); u=np.array([1,-1,0])/2**.5; w=np.array([1,1,-2])/6**.5\n        P2=np.array([[np.dot(p-c0,u),np.dot(p-c0,w)] for p in pts])\n        order=np.argsort(np.arctan2(P2[:,1],P2[:,0])); P2=P2[order]\n        x,y=P2[:,0],P2[:,1]; x1,y1=np.roll(x,-1),np.roll(y,-1); cr=x*y1-x1*y\n        Ar=cr.sum()/2\n        if abs(Ar)<1e-12: G=pts.mean(0)  # segment: use endpoints midpoint\n        else:\n            gx=((x+x1)*cr).sum()/(6*Ar); gy=((y+y1)*cr).sum()/(6*Ar); G=c0+gx*u+gy*w\n    r=minimize(lambda p:((p-vcg)**2).sum(),pts.mean(0),constraints=[{'type':'ineq','fun':lambda p,a=a,bb=bb:bb-np.dot(a,p)} for a,bb in cons]+[{'type':'eq','fun':lambda p:p.sum()-R}],method='SLSQP',options={'ftol':1e-14})\n    return G,r.x,vcg,R,len(pts)\ndef sol(vP,v):\n    e=sum(v)-vP; c=[min(x,e) for x in v]\n    return vP<=min(v)+1e-9 or (abs(c[0]-c[1])<1e-9 and abs(c[1]-c[2])<1e-9)\nbad=0\nfor _ in range(3000):\n    v=[random.choice([random.randint(1,10),random.uniform(0.1,10)]) for i in range(3)]\n    if random.random()<0.3: v[1]=v[0]\n    vP=random.uniform(0,sum(v))\n    G,q,vcg,R,n=analyze(vP,v)\n    eq=np.abs(G-q).max()<1e-5\n    if eq!=sol(vP,v): bad+=1; print(vP,v,G,q,n)\nprint(\"mismatch\",bad)\n","exit_code":0,"status":"completed"}}
