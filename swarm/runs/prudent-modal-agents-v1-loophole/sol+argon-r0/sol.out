{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > /work/verify_characterization.py <<'EOF'\n\\\"\\\"\\\"Random semantic cross-check of the six depth-one conditions.\\\"\\\"\\\"\nimport random\nrandom.seed(20261022)\n# Agents ordered CB, DB, FB, X. S[y] records opponent y's (a,c,d).\nconditions = {0:1, 1<<7:0, 1<<0:0, (1<<7)|(1<<0):1,\n              (1<<7)|(1<<0)|(1<<4):1,\n              (1<<7)|(1<<6)|(1<<2):1}\nfor trial in range(10000):\n    f = [random.randrange(2) for _ in range(256)]\n    S = [0]*4\n    fb = [1]*4\n    for n in range(20):\n        actions = [[1]*4, [0]*4, fb[:], [f[s] for s in S]]\n        for y in range(4):\n            v = 4*actions[y][3] + 2*actions[y][0] + actions[y][1]\n            S[y] |= 1 << v\n        fb = [fb[y] & actions[y][2] for y in range(4)]\n    actual = actions[3] == [0,0,1,1]\n    predicted = all(f[s] == value for s,value in conditions.items())\n    assert actual == predicted, (trial, actual, predicted)\nprint('All 10000 random semantic functions match the characterization.')\nEOF\npython3 /work/verify_characterization.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > /work/verify_characterization.py <<'EOF'\n\\\"\\\"\\\"Random semantic cross-check of the six depth-one conditions.\\\"\\\"\\\"\nimport random\nrandom.seed(20261022)\n# Agents ordered CB, DB, FB, X. S[y] records opponent y's (a,c,d).\nconditions = {0:1, 1<<7:0, 1<<0:0, (1<<7)|(1<<0):1,\n              (1<<7)|(1<<0)|(1<<4):1,\n              (1<<7)|(1<<6)|(1<<2):1}\nfor trial in range(10000):\n    f = [random.randrange(2) for _ in range(256)]\n    S = [0]*4\n    fb = [1]*4\n    for n in range(20):\n        actions = [[1]*4, [0]*4, fb[:], [f[s] for s in S]]\n        for y in range(4):\n            v = 4*actions[y][3] + 2*actions[y][0] + actions[y][1]\n            S[y] |= 1 << v\n        fb = [fb[y] & actions[y][2] for y in range(4)]\n    actual = actions[3] == [0,0,1,1]\n    predicted = all(f[s] == value for s,value in conditions.items())\n    assert actual == predicted, (trial, actual, predicted)\nprint('All 10000 random semantic functions match the characterization.')\nEOF\npython3 /work/verify_characterization.py\"","aggregated_output":"All 10000 random semantic functions match the characterization.\n","exit_code":0,"status":"completed"}}
