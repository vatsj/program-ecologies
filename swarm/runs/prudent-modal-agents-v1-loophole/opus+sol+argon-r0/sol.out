{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cp /work/opus/minsize.py /work/sol_minsize.py\npython3 - <<'PY'\np='/work/sol_minsize.py'\ns=open(p).read()\nstart=s.index('def closure(')\nend=s.index('def par(',start)\ns=s[:start]+'''def closure(leaves, nbits, maxn):\n    full=(1<<nbits)-1\n    best={}\n    by={}\n    for n in range(1,maxn+1):\n        new=[]\n        def add(r, txt):\n            if r not in best:\n                best[r]=(n,txt)\n                new.append(r)\n        for sem,(sz,txt) in leaves.items():\n            if sz == n: add(sem,txt)\n        for s in by.get(n-1,[]):\n            add(full\"'^s, '\"'~'+par(best[s][1]))\n        for i in range(1,n-1):\n            j=n-1-i\n            for s in by.get(i,[]):\n                for t in by.get(j,[]):\n                    for op,r in (('&',s&t),('|',s|t),('->',(full\"'^s)|t)):\n                        add(r, par(best[s][1])+op+par(best[t][1]))\n        by[n]=new\n    return best\n'\"''' + s[end:]\nopen(p,'w').write(s)\nPY\npython3 /work/sol_minsize.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
