{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'cat /work/opus/enum.py'","aggregated_output":"# enumerate formulas by AST size (nodes; '->' counts 1), find smallest prudent ones\nimport random, sys, itertools\nW=14; M=(1<<W)-1\ndef box(v):\n    # box[n] = all v[m] for m<n\n    r=0; ok=True\n    for n in range(W):\n        if ok: r|=1<<n\n        ok = ok and (v>>n)&1\n    return r\nrandom.seed(1)\ndef rseq():\n    k=random.randrange(W); v=random.getrandbits(W)&((1<<k)-1)\n    return v | ((M ^ ((1<<k)-1)) if random.random()<.5 else 0)\nctxs=[(rseq(),rseq(),rseq()) for _ in range(200)]\nones=(M,M,M); zeros=(0,0,0)\nFBd=1  # FB vs DB = box F: true only at world 0\nctxs+= [ones,zeros]\n# formula objects: (text, prec-free text with parens, fn(ctx)->vec, guarded flag, depth)\ndef ev(f,ctx):\n    t=f[0]\n    if t=='a':return ctx[0]\n    if t=='c':return ctx[1]\n    if t=='d':return ctx[2]\n    if t=='T':return M\n    if t=='F':return 0\n    if t=='~':return M^ev(f[1],ctx)\n    if t=='&':return ev(f[1],ctx)&ev(f[2],ctx)\n    if t=='|':return ev(f[1],ctx)|ev(f[2],ctx)\n    if t=='>':return (M^ev(f[1],ctx))|ev(f[2],ctx)\n    if t=='B':return box(ev(f[1],ctx))\ndef txt(f):\n    t=f[0]\n    if len(f)==1: return t\n    if t=='~': return '~('+txt(f[1])+')'\n    if t=='B': return 'B('+txt(f[1])+')'\n    op={'&':'&','|':'|','>':'->'}[t]\n    return '('+txt(f[1])+' '+op+' '+txt(f[2])+')'\ndef guarded(f,inside=False):\n    if f[0] in 'acd': return inside\n    if f[0]=='B': return guarded(f[1],True)\n    return all(guarded(g,inside) for g in f[1:])\ndef dep(f):\n    if f[0]=='B': return 1+dep(f[1])\n    return max([dep(g) for g in f[1:]],default=0)\ndef solve(f):\n    vC=ev(f,ones); vD=ev(f,zeros)\n    # vs FB: FB's c = M, FB's d = 1 (world0 only); a = FB action = box(x)\n    x=0\n    for _ in range(W+1):\n        x=ev(f,(box(x),M,FBd))\n    fb=box(x)\n    s=0\n    for _ in range(W+1):\n        s=ev(f,(s,vC,vD))\n    last=lambda v:(v>>(W-1))&1\n    return last(vC),last(vD),last(x),last(fb),last(s)\nmaxsize=int(sys.argv[1])\nby={}  # size -> list of formulas (semantically deduped)\nseen=set()\ndef add(sz,f):\n    key=(tuple(ev(f,c) for c in ctxs),guarded(f))\n    if key in seen: return\n    seen.add(key); by.setdefault(sz,[]).append(f)\nfor s in range(1,maxsize+1):\n    if s==1:\n        for t in 'acdTF': add(1,(t,))\n    else:\n        for g in list(by.get(s-1,[])):\n            add(s,('~',g)); add(s,('B',g))\n        for i in range(1,s-1):\n            for g in by.get(i,[]):\n                for h in by.get(s-1-i,[]):\n                    for op in '&|>': add(s,(op,g,h))\n    found=0\n    for f in by.get(s,[]):\n        if guarded(f):\n            r=solve(f)\n            if r==(0,0,1,1,1):\n                found+=1; print(s,dep(f),txt(f))\n    print('size',s,'classes',len(by.get(s,[])),'prudent',found,flush=True)\n","exit_code":0,"status":"completed"}}
