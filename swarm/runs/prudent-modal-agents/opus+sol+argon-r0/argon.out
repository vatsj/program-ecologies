{"type":"tool_use","timestamp":"2026-10-22T22:03:36.120Z","tool_name":"write_file","tool_id":"write_file__call_299940","parameters":{"content":"#!/usr/bin/env python3\n\"\"\"Exact (non-heuristic) exhaustive verification of minimal formula size for prudent modal agents.\"\"\"\nfrom functools import lru_cache\nimport check\n\n\ndef gen(size, inside, allow_const=True):\n    if size == 1:\n        if allow_const:\n            yield (\"T\",), \"T\"\n            yield (\"F\",), \"F\"\n        if inside:\n            yield (\"a\",), \"a\"\n            yield (\"c\",), \"c\"\n            yield (\"d\",), \"d\"\n        return\n    for ast, s in gen(size - 1, inside, allow_const):\n        yield (\"not\", ast), f\"~{s}\" if len(s) == 1 or s.startswith((\"B(\", \"(\", \"~\")) else f\"~({s})\"\n    for ast, s in gen(size - 1, True, allow_const):\n        yield (\"box\", ast), f\"B({s})\"\n    for left_size in range(1, size - 1):\n        right_size = size - 1 - left_size\n        for l_ast, l_s in gen(left_size, inside, allow_const):\n            for r_ast, r_s in gen(right_size, inside, allow_const):\n                yield (\"and\", l_ast, r_ast), f\"({l_s} & {r_s})\"\n                yield (\"or\", l_ast, r_ast), f\"({l_s} | {r_s})\"\n                yield (\"or\", (\"not\", l_ast), r_ast), f\"({l_s} -> {r_s})\"\n\n\ndef is_prudent(X, W=20):\n    agents = {\"CB\": (\"T\",), \"DB\": (\"F\",), \"FB\": (\"box\", (\"a\",)), \"X\": X}\n\n    @lru_cache(maxsize=None)\n    def act(x, y, n):\n        return ev(agents[x], n, x, y)\n\n    def ev(f, n, me, opp):\n        t = f[0]\n        if t == \"T\":\n            return True\n        if t == \"F\":\n            return False\n        if t == \"a\":\n            return act(opp, me, n)\n        if t == \"c\":\n            return act(opp, \"CB\", n)\n        if t == \"d\":\n            return act(opp, \"DB\", n)\n        if t == \"not\":\n            return not ev(f[1], n, me, opp)\n        if t == \"and\":\n            return ev(f[1], n, me, opp) and ev(f[2], n, me, opp)\n        if t == \"or\":\n            return ev(f[1], n, me, opp) or ev(f[2], n, me, opp)\n        if t == \"box\":\n            return all(ev(f[1], m, me, opp) for m in range(n))\n\n    if act(\"X\", \"CB\", W - 1):\n        return False\n    if act(\"X\", \"DB\", W - 1):\n        return False\n    if not act(\"X\", \"FB\", W - 1):\n        return False\n    if not act(\"FB\", \"X\", W - 1):\n        return False\n    if not act(\"X\", \"X\", W - 1):\n        return False\n    return True\n\n\nif __name__ == \"__main__\":\n    for allow_const in [True, False]:\n        max_s = 7 if allow_const else 8\n        print(f\"=== Exact AST search (allow_const={allow_const}, up to size {max_s}) ===\")\n        total = 0\n        for s in range(1, max_s + 1):\n            found = []\n            count = 0\n            for ast, f_str in gen(s, False, allow_const):\n                count += 1\n                if is_prudent(ast):\n                    _, r = check.outcomes(f_str)\n                    assert r == {\"CB\": \"D\", \"DB\": \"D\", \"FB\": \"C\", \"X\": \"C\", \"FB_reply\": \"C\"}\n                    found.append(f_str)\n            total += count\n            print(f\"Size {s}: tested all {count} ASTs, found {len(found)} prudent\")\n            for ex in found:\n                print(\"  ->\", ex)\n        print(f\"Total ASTs tested: {total}\\n\")\n","file_path":"/work/verify_min_size.py"}}
