{"type":"tool_use","timestamp":"2026-10-22T22:02:30.676Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_437618","parameters":{"description":"Run fast AST enumeration for depth<=2 formulas with and without constants","command":"python3 -c '\nfrom functools import lru_cache\n\ndef gen(size, inside, max_depth, allow_const=True):\n    if size == 1:\n        if allow_const:\n            yield (\"T\",), \"T\"\n            yield (\"F\",), \"F\"\n        if inside:\n            yield (\"a\",), \"a\"\n            yield (\"c\",), \"c\"\n            yield (\"d\",), \"d\"\n        return\n    for ast, s in gen(size - 1, inside, max_depth, allow_const):\n        yield (\"not\", ast), f\"~{s}\" if len(s) == 1 or s.startswith((\"B(\", \"(\", \"~\")) else f\"~({s})\"\n    if max_depth >= 1:\n        for ast, s in gen(size - 1, True, max_depth - 1, allow_const):\n            yield (\"box\", ast), f\"B({s})\"\n    for left_size in range(1, size - 1):\n        right_size = size - 1 - left_size\n        for l_ast, l_s in gen(left_size, inside, max_depth, allow_const):\n            for r_ast, r_s in gen(right_size, inside, max_depth, allow_const):\n                yield (\"and\", l_ast, r_ast), f\"({l_s} & {r_s})\"\n                yield (\"or\", l_ast, r_ast), f\"({l_s} | {r_s})\"\n                yield (\"or\", (\"not\", l_ast), r_ast), f\"({l_s} -> {r_s})\"\n\ndef is_prudent(X, W=12):\n    agents = {\"CB\": (\"T\",), \"DB\": (\"F\",), \"FB\": (\"box\", (\"a\",)), \"X\": X}\n    @lru_cache(maxsize=None)\n    def act(x, y, n):\n        return ev(agents[x], n, x, y)\n    def ev(f, n, me, opp):\n        t = f[0]\n        if t == \"T\": return True\n        if t == \"F\": return False\n        if t == \"a\": return act(opp, me, n)\n        if t == \"c\": return act(opp, \"CB\", n)\n        if t == \"d\": return act(opp, \"DB\", n)\n        if t == \"not\": return not ev(f[1], n, me, opp)\n        if t == \"and\": return ev(f[1], n, me, opp) and ev(f[2], n, me, opp)\n        if t == \"or\": return ev(f[1], n, me, opp) or ev(f[2], n, me, opp)\n        if t == \"box\": return all(ev(f[1], m, me, opp) for m in range(n))\n    if act(\"X\", \"CB\", W-1): return False\n    if act(\"X\", \"DB\", W-1): return False\n    if not act(\"X\", \"FB\", W-1): return False\n    if not act(\"FB\", \"X\", W-1): return False\n    if not act(\"X\", \"X\", W-1): return False\n    return True\n\nfor allow_const in [True, False]:\n    max_s = 7 if allow_const else 8\n    print(f\"=== Search allow_const={allow_const}, depth<=2, up to size {max_s} ===\")\n    for s in range(1, max_s + 1):\n        found = []\n        count = 0\n        for ast, f_str in gen(s, False, 2, allow_const):\n            count += 1\n            if is_prudent(ast):\n                found.append(f_str)\n        print(f\"Size {s}: tested {count} formulas, found {len(found)} prudent\")\n        if found:\n            for ex in found[:15]:\n                print(\"  Example:\", ex)\n            break\n'"}}
