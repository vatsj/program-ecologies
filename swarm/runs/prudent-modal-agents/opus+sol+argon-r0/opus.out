,FBd))\n    fb=box(x)\n    s=0\n    for _ in range(W+1):\n        s=ev(f,(s,vC,vD))\n    last=lambda v:(v>>(W-1))&1\n    return last(vC),last(vD),last(x),last(fb),last(s)\nmaxsize=int(sys.argv[1])\nby={}  # size -> list of formulas (semantically deduped)\nseen=set()\ndef add(sz,f):\n    key=(tuple(ev(f,c) for c in ctxs),guarded(f))\n    if key in seen: return\n    seen.add(key); by.setdefault(sz,[]).append(f)\nfor s in range(1,maxsize+1):\n    if s==1:\n        for t in 'acdTF': add(1,(t,))\n    else:\n        for g in list(by.get(s-1,[])):\n            add(s,('~',g)); add(s,('B',g))\n        for i in range(1,s-1):\n            for g in by.get(i,[]):\n                for h in by.get(s-1-i,[]):\n                    for op in '&|>': add(s,(op,g,h))\n    found=0\n    for f in by.get(s,[]):\n        if guarded(f):\n            r=solve(f)\n            if r==(0,0,1,1,1):\n                found+=1; print(s,dep(f),txt(f))\n    print('size',s,'classes',len(by.get(s,[])),'prudent',found,flush=True)\nEOF\ncd /work/opus && timeout 600 python3 enum.py 8 2>&1 | tail -40","uuid":"6acd9600-0877-46c3-b1d7-2ecee9ba981a","session_id":"d1146e5c-84be-4d08-bc92-04d94440795d"}
