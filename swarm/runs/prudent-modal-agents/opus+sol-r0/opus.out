dal(f): continue\n            r,_=run(f)\n            if not r['CB'] and not r['DB'] and r['FB'] and r['R'] and r['X']:\n                print(n,show(f)); cnt+=1\n        print('size',n,'prudent',cnt,flush=True)\nEOF\ncd /work/opus && timeout 900 python3 search.py 7 | tail -40","uuid":"9b426144-b214-466c-9bc8-a24c3ecbfb3f","session_id":"3628ae6d-bc3f-4844-8036-102eeecb6be9"}
